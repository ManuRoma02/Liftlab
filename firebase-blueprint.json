{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user settings and basic profile info",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "it", "es"] },
        "unit": { "type": "string", "enum": ["KG", "LBS"] },
        "restTimer": { "type": "integer" },
        "currentWeight": { "type": "number" },
        "dashboardStats": { "type": "array", "items": { "type": "string" } },
        "hasCompletedTutorial": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email", "language", "unit"]
    },
    "Routine": {
      "title": "Workout Routine",
      "description": "A reusable workout template",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "duration": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "scheduledDay": { "type": "integer" },
        "exercises": { 
          "type": "array", 
          "items": { "$ref": "#/entities/Exercise" } 
        },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "userId"]
    },
    "Exercise": {
      "title": "Exercise Data",
      "description": "Information about a specific exercise in a routine or log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "notes": { "type": "string" },
        "image": { "type": "string" },
        "sets": { "type": "array", "items": { "$ref": "#/entities/Set" } },
        "technique": { "type": "string" },
        "supersetId": { "type": "string" },
        "equipment": { "type": "string" },
        "muscleFocus": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "array", "items": { "type": "string" } },
        "cues": { "type": "array", "items": { "type": "string" } },
        "prWeight": { "type": "number" },
        "prReps": { "type": "integer" },
        "prRepsWeight": { "type": "number" },
        "oneRepMax": { "type": "number" }
      }
    },
    "Set": {
      "title": "Workout Set",
      "description": "A single set of an exercise",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "weight": { "type": "number" },
        "reps": { "type": "integer" },
        "completed": { "type": "boolean" },
        "technique": { "type": "string" }
      }
    },
    "CustomExercise": {
      "title": "Custom Exercise Definition",
      "description": "A user-defined exercise",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "equipment": { "type": "string" },
        "muscleFocus": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "array", "items": { "type": "string" } },
        "cues": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "image": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["title", "userId"]
    },
    "WorkoutLog": {
      "title": "Workout Log",
      "description": "Historical record of a completed workout",
      "type": "object",
      "properties": {
        "routineId": { "type": "string" },
        "routineName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "integer" },
        "exercises": { 
          "type": "array", 
          "items": { "$ref": "#/entities/Exercise" } 
        },
        "userId": { "type": "string" }
      },
      "required": ["routineName", "userId", "date"]
    },
    "PR": {
      "title": "Personal Record",
      "description": "Specific PR for an exercise to avoid heavy reads/writes on large arrays",
      "type": "object",
      "properties": {
        "exerciseId": { "type": "string" },
        "exerciseTitle": { "type": "string" },
        "prWeight": { "type": "number" },
        "prReps": { "type": "integer" },
        "prRepsWeight": { "type": "number" },
        "oneRepMax": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Root user profile"
    },
    "users/{userId}/routines/{routineId}": {
      "schema": "Routine",
      "description": "User created routines"
    },
    "users/{userId}/workout_logs/{logId}": {
      "schema": "WorkoutLog",
      "description": "History of workouts"
    },
    "users/{userId}/custom_exercises/{exerciseId}": {
      "schema": "CustomExercise",
      "description": "User defined exercises"
    },
    "users/{userId}/personal_records/{exerciseId}": {
      "schema": "PR",
      "description": "Aggregated PRs per exercise for fast lookups"
    }
  }
}
